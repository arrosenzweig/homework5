# Campus Customs — environment template
#
# Copy this file to .env and fill in your own key:
#
#     cp .env.example .env
#
# .env is git-ignored and must never be committed.

# --- Required -------------------------------------------------------------
# Portkey gateway key. The agent team reaches the model through Portkey, which
# is OpenAI-compatible, so only the base URL and the auth header differ.
PORTKEY_API_KEY=your_portkey_api_key_here

# --- Optional -------------------------------------------------------------
# Portkey gateway endpoint. Only set this if you are not using the default.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model the five agents run on.
# SHOP_MODEL=gpt-5.6-luna

# Override the database the MCP server reads. Defaults to
# data/campus_customs_new.db, resolved relative to the project root.
# CAMPUS_CUSTOMS_DB=/absolute/path/to/campus_customs_new.db

# Override where the append-only audit trail is written.
# Defaults to output/audit_trail.json.
# CAMPUS_CUSTOMS_AUDIT=/absolute/path/to/audit_trail.json

# --- Frontend -------------------------------------------------------------
# Vite reads this at build time. Defaults to http://localhost:8000.
# VITE_API_BASE=http://localhost:8000
